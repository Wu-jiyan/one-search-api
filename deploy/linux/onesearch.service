[Unit]
Description=One Search API (DeepSeek-compatible search/fetch gateway)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=onesearch
Group=onesearch
WorkingDirectory=/www/wwwroot/onesearch
ExecStart=/www/wwwroot/onesearch/onesearch -config /www/wwwroot/onesearch/config.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
